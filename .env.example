# Token from @BotFather (required)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone).
# Your ID: message @userinfobot
ALLOWED_USERS=

# Parallel downloads and download attempts (each attempt resumes partial files)
MAX_CONCURRENT=2
DOWNLOAD_ATTEMPTS=5

# Leftovers of failed downloads are removed after this many hours
STALE_HOURS=24

# --- Local Bot API server (uploads up to 2000 MB instead of 50 MB) ---
# 1. Get api_id / api_hash at https://my.telegram.org -> API development tools
# 2. Uncomment the four lines below
#COMPOSE_PROFILES=local-api
#BOT_API_URL=http://telegram-bot-api:8081
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

# Upload limit override in MB (default: 50, or 2000 with BOT_API_URL)
#MAX_FILE_MB=
